{
  "name": "fieldwork",
  "version": "0.2.0",
  "description": "Local-first research workspace core",
  "type": "module",
  "private": true,
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "fieldwork": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:web": "tsc -p web --noEmit && vite build --config web/vite.config.ts",
    "test": "vitest run --test-timeout 15000",
    "test:browser": "npm run build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "markdown-it": "^15.0.1",
    "write-file-atomic": "^8.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
